<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "fanctrlplusplus">
<!ENTITY version "0.0.4">
<!ENTITY author "willdollman">
<!ENTITY launch "Settings/fanctrlplusplus">
<!ENTITY pluginURL "https://raw.githubusercontent.com/willdollman/fanctrl/main/unraid/fanctrlplusplus.plg">
<!ENTITY source "/boot/config/plugins/&name;">
<!ENTITY txz "&source;/&name;-&version;.txz">
<!ENTITY MD5 "494c1205fec281b22794f5df741a3b58">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.9.0">
<ICON>/usr/local/emhttp/plugins/fanctrlplusplus/images/fanctrlplus.png</ICON>
<CHANGES>
###0.0.5
- Kept setup controls interactive when Unraid remounts page elements.

###0.0.4
- Fixed Add Fan not updating the interface.
- Fixed slider fills for ranges with non-zero minimum values.

###0.0.3
- Fixed the FanCtrl PlusPlus page not appearing under Settings.

###0.0.2
- Initial public FanCtrl PlusPlus release.
- Added one-hour transient temperature, RPM, and PWM history with CSV export.
- Added safe 10–100% manual PWM setup tests with explicit stop and a 10-minute fail-safe.
</CHANGES>
<FILE Run="/bin/bash">
<INLINE>
#!/bin/bash
md5=$(md5sum &txz; 2>/dev/null | awk '{print $1}')
[[ $md5 == &MD5; ]] || rm -f &source;/*.txz
</INLINE>
</FILE>
<FILE Name="&txz;" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/willdollman/fanctrl/releases/download/v&version;/fanctrlplusplus-&version;.txz</URL>
<MD5>&MD5;</MD5>
</FILE>
<FILE Run="/bin/bash" Method="remove">
<INLINE>
#!/bin/bash
if ! /etc/rc.d/rc.fanctrlplusplus stop; then
  echo "Cannot uninstall: manual PWM restoration failed; plugin retained." > /dev/stderr
  exit 1
fi
pkill -f '/usr/local/emhttp/plugins/fanctrlplusplus/scripts/array_monitor.sh' 2>/dev/null || true
rm -rf /usr/local/emhttp/plugins/fanctrlplusplus /boot/config/plugins/fanctrlplusplus /var/tmp/fanctrlplusplus
rm -f /etc/rc.d/rc.fanctrlplusplus /var/run/fanctrlplusplus.user_stopped /var/run/fanctrlplusplus_history.lock /var/run/fanctrlplusplus_manual.lock /var/run/fanctrlplusplus_*.pid
echo "FanCtrl PlusPlus has been removed. Reboot before enabling another fan controller."
</INLINE>
</FILE>
</PLUGIN>
