Menu="Utilities"
Title="FanCtrl PlusPlus"
Icon="fanctrlplus.png"
---
<?php
$plugin  = "fanctrlplusplus";
$docroot = $docroot ?? ($_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp');
$cfg_dir = "/boot/config/plugins/$plugin";

require_once "$docroot/plugins/$plugin/include/Common.php";
require_once "$docroot/plugins/$plugin/include/FanBlockRender.php";
require_once "$docroot/plugins/$plugin/include/OrderManager.php";

if (!is_dir($cfg_dir)) mkdir($cfg_dir, 0777, true);

// migrate old hwmonX paths if the board re-enumerated
migrate_cfg_and_labels($plugin);

// ---- load fan cfgs in saved order (legacy order.cfg: left+right merged) ----
$order = OrderManager::readOrder();
$ordered = array_merge($order['left'], $order['right']);
$all_files = array_map('basename', glob("$cfg_dir/{$plugin}_*.cfg") ?: []);
$files = array_values(array_unique(array_merge(
  array_values(array_filter($ordered, fn($f) => in_array($f, $all_files, true))),
  $all_files
)));

$fans = [];
foreach ($files as $f) {
  $cfg = parse_ini_file("$cfg_dir/$f");
  if ($cfg === false) continue;
  $cfg['file'] = $f;
  $fans[] = $cfg;
}

$pwms         = list_pwm();
$disk_groups  = list_valid_disks_by_id();
$temp_sensors = list_temp_sensors();

// airflow tile state
$airflow_on = false;
if (is_file("$cfg_dir/pwm_labels.cfg")) {
  foreach (file("$cfg_dir/pwm_labels.cfg", FILE_IGNORE_NEW_LINES) as $line) {
    if (preg_match('/^__FCP_AIRFLOW__\s*=\s*(\d)/', trim($line), $m)) $airflow_on = $m[1] === '1';
  }
}
$version = trim(@file_get_contents("$docroot/plugins/$plugin/VERSION") ?: '');
?>
<link rel="stylesheet" href="/plugins/fanctrlplusplus/css/fcp2.css?v=2.0.0">
<script src="/plugins/fanctrlplusplus/js/chart.min.js"></script>

<div class="fcp2">

  <div class="fcp2-topbar">
    <div class="fcp2-title">
      <svg class="fcp2-fanglyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <circle cx="12" cy="12" r="2.4"/>
        <path d="M12 9.6c0-3-1-5.6-3.4-5.6C6 4 5.2 6.4 6.6 8.2c1 1.3 3 1.6 5.4 1.4z"/>
        <path d="M14.1 13.2c2.6 1.5 5.4 1.9 6.6-.2 1.2-2.2-.5-4.1-2.8-4-1.7 0-3.2 1.5-3.8 4.2z"/>
        <path d="M9.9 13.2c-2.6 1.5-4.4 3.7-3.2 5.8 1.3 2.2 3.8 1.7 4.7-.4.7-1.6.1-3.6-1.5-5.4z"/>
      </svg>
      <div>
        <h1>FanCtrl PlusPlus</h1>
        <span class="fcp2-sub">Fan speed updates every 5 s · SMART polled per fan</span>
      </div>
    </div>
    <span class="fcp2-pill" id="fcp2-status"><span class="dot"></span><span class="txt">…</span></span>
    <button type="button" class="btn btn-accent" id="fcp2-applyall" disabled>Apply changes</button>
  </div>

  <div class="fcp2-manual-warning" id="fcp2-manual-warning" role="alert" hidden>
    <strong>Manual fan speed test active</strong>
    <span id="fcp2-manual-warning-text"></span>
    <button type="button" class="btn btn-danger fcp2-manual-stop">Stop test</button>
  </div>

  <div class="fcp2-grid" id="fcp2-grid">
    <?php foreach ($fans as $cfg) echo render_fan_card($cfg, $pwms, $disk_groups, $temp_sensors, $pwm_labels); ?>
    <button type="button" class="fcp2-addcard" id="fcp2-addfan">+ Add fan</button>
  </div>

  <div class="fcp2-panel">
    <h2>PWM outputs</h2>
    <div class="fcp2-outputs">
      <?php foreach ($pwms as $pwm): $p = $pwm['sensor']; ?>
      <div class="fcp2-outrow2" data-pwm="<?= htmlspecialchars($p) ?>">
        <span class="name"><?= htmlspecialchars($pwm['chip'] . ' · ' . $pwm['name']) ?></span>
        <input type="text" class="label-in" placeholder="Label (e.g. Rear exhaust)"
               value="<?= htmlspecialchars($pwm_labels[$p] ?? '') ?>">
        <button type="button" class="btn o-savelabel">Save label</button>
      </div>
      <?php endforeach; ?>
      <?php if (empty($pwms)): ?><span class="muted">No PWM-capable fan headers found.</span><?php endif; ?>
    </div>
    <details class="fcp2-manual" id="fcp2-manual">
      <summary>Manual fan speed test</summary>
      <div class="fcp2-manual-body">
        <label>Controller
          <select id="fcp2-manual-controller">
            <?php foreach ($pwms as $pwm): $p = $pwm['sensor']; $label = trim($pwm_labels[$p] ?? ''); ?>
              <option value="<?= htmlspecialchars($p) ?>"><?= htmlspecialchars(($label ? $label . ' — ' : '') . $pwm['chip'] . ' · ' . $pwm['name']) ?></option>
            <?php endforeach; ?>
          </select>
        </label>
        <div class="fcp2-manual-speed">
          <label for="fcp2-manual-range">Speed</label>
          <input id="fcp2-manual-range" type="range" min="10" max="100" value="40">
          <span class="fcp2-num"><input id="fcp2-manual-percent" type="number" min="10" max="100" step="1" value="40"><span class="unit">%</span></span>
        </div>
        <div class="fcp2-manual-actions">
          <button type="button" class="btn btn-accent" id="fcp2-manual-start" <?= empty($pwms) ? 'disabled' : '' ?>>Start test</button>
          <button type="button" class="btn btn-danger fcp2-manual-stop" disabled>Stop test</button>
        </div>
        <p class="fcp2-help"><strong>Warning:</strong> Low speeds can still stall some fans. Monitor the fan physically. The test requires an explicit stop and automatically stops after 10 minutes as a fail-safe.</p>
      </div>
    </details>
    <div class="fcp2-airflow">
      <label class="tgl"><input type="checkbox" id="fcp2-airflow" <?= $airflow_on ? 'checked' : '' ?>><span class="tr"></span></label>
      Show FCP Airflow tile on the Dashboard
    </div>
  </div>

</div>

<!-- templates for newly added sources -->
<template id="fcp2-tpl-disks"><?= fcp_render_source(
  ['type' => 'disks', 'disks' => '', 'path' => '', 'low' => 38, 'high' => 48],
  $disk_groups, $temp_sensors) ?></template>
<template id="fcp2-tpl-temp"><?= fcp_render_source(
  ['type' => 'temp', 'disks' => '', 'path' => array_key_first($temp_sensors) ?? '', 'low' => 45, 'high' => 80],
  $disk_groups, $temp_sensors) ?></template>
<template id="fcp2-tpl-fan"><?= render_fan_card([
  'file' => '', 'custom' => '', 'service' => '1', 'controller' => '',
  'pwm' => '102', 'max' => '255', 'idle' => '0', 'quiet' => '0',
  'quiet_cap' => '150', 'interval' => '2', 'syslog' => '1', 'sources' => '0',
], $pwms, $disk_groups, $temp_sensors, $pwm_labels) ?></template>

<div class="fcp2 fcp2-toast" id="fcp2-toast"></div>

<div class="fcp2 fcp2-history-backdrop" id="fcp2-history" hidden>
  <div class="fcp2-history-modal" role="dialog" aria-modal="true" aria-labelledby="fcp2-history-title">
    <div class="fcp2-history-head">
      <h2 id="fcp2-history-title">Fan history</h2>
      <button type="button" class="btn-link fcp2-history-close" aria-label="Close history">Close</button>
    </div>
    <div class="fcp2-history-empty" aria-live="polite">No history data yet.</div>
    <div class="fcp2-history-charts" hidden>
      <div class="fcp2-chart"><canvas id="fcp2-history-temp" aria-label="Temperature history chart" role="img"></canvas></div>
      <div class="fcp2-chart"><canvas id="fcp2-history-speed" aria-label="Fan speed history chart" role="img"></canvas></div>
    </div>
    <div class="fcp2-history-foot">
      <a class="btn fcp2-history-export" href="#">Export CSV</a>
      <button type="button" class="btn fcp2-history-close">Close</button>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';
  // Ensure the responsive grid collapses on phones even if the page shell
  // lacks a viewport meta tag (older Unraid layouts).
  if (!document.querySelector('meta[name="viewport"]')) {
    const m = document.createElement('meta');
    m.name = 'viewport';
    m.content = 'width=device-width, initial-scale=1';
    document.head.appendChild(m);
  }
  const API = '/plugins/fanctrlplusplus/include/FanctrlLogic.php';
  const SAVE = '/plugins/fanctrlplusplus/include/update.fanctrlplusplus.php';
  const $ = (el, sel) => el.querySelector(sel);
  const $$ = (el, sel) => Array.from(el.querySelectorAll(sel));
  // Unraid's newer web UI can replace mounted page elements, which silently
  // detaches nodes captured in constants and drops their event listeners.
  // All element lookups are therefore lazy and all events are delegated
  // from document (capture phase) so every control keeps working.
  const historyModal = () => document.getElementById('fcp2-history');
  let historyCharts = [];
  let historyRequest = 0;
  let manualActive = false;

  function manualElements() {
    return {
      details: document.getElementById('fcp2-manual'),
      controller: document.getElementById('fcp2-manual-controller'),
      range: document.getElementById('fcp2-manual-range'),
      percent: document.getElementById('fcp2-manual-percent'),
      start: document.getElementById('fcp2-manual-start'),
      warning: document.getElementById('fcp2-manual-warning'),
    };
  }

  function closeHistory() {
    historyRequest++;
    historyCharts.forEach(chart => chart.destroy());
    historyCharts = [];
    historyModal().hidden = true;
  }
  async function openHistory(card) {
    const name = card.dataset.savedName;
    if (!name) { toast('Save the fan first', true); return; }
    closeHistory();
    const modal = historyModal();
    modal.hidden = false;
    document.getElementById('fcp2-history-title').textContent = `${name} — one-hour transient history`;
    $(modal, '.fcp2-history-export').href = `${API}?op=export_history&custom=${encodeURIComponent(name)}`;
    const empty = $(modal, '.fcp2-history-empty');
    const charts = $(modal, '.fcp2-history-charts');
    empty.textContent = 'Loading history…'; empty.hidden = false; charts.hidden = true;
    $(modal, '.fcp2-history-close').focus();
    const request = ++historyRequest;
    try {
      const data = await (await fetch(`${API}?op=history&custom=${encodeURIComponent(name)}`)).json();
      // Re-resolve the modal after the await: Unraid's UI can clone-replace
      // DOM subtrees, leaving pre-await node references detached.
      const modal = historyModal();
      const empty = $(modal, '.fcp2-history-empty');
      const charts = $(modal, '.fcp2-history-charts');
      if (request !== historyRequest || modal.hidden) return;
      if (!data.samples || !data.samples.length) { empty.textContent = 'No history data yet.'; return; }
      const labels = data.samples.map(s => new Date(s.timestamp * 1000).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'}));
      const common = { responsive: true, maintainAspectRatio: false, elements: { point: { radius: 0 } },
        interaction: { intersect: false }, plugins: { legend: { labels: { color: '#dfe3ea' } } },
        scales: { x: { ticks: { color: '#8b93a2', autoSkip: true, maxTicksLimit: 8 }, grid: { color: '#2e333d' } } } };
      empty.hidden = true; charts.hidden = false;
      historyCharts.push(new Chart(document.getElementById('fcp2-history-temp'), { type: 'line', data: { labels,
        datasets: [{ label: 'Temperature °C', data: data.samples.map(s => s.temp_c), borderColor: '#ff8c2f', spanGaps: false }] },
        options: {...common, scales: {...common.scales, y: { ticks: { color: '#8b93a2' }, grid: { color: '#2e333d' }, title: { display: true, text: '°C', color: '#8b93a2' } }}} }));
      historyCharts.push(new Chart(document.getElementById('fcp2-history-speed'), { type: 'line', data: { labels, datasets: [
        { label: 'RPM', data: data.samples.map(s => s.rpm), borderColor: '#6ab0ff', yAxisID: 'rpm', spanGaps: false },
        { label: 'PWM %', data: data.samples.map(s => s.pwm_percent), borderColor: '#34d17b', yAxisID: 'pwm', spanGaps: false }
      ]}, options: {...common, scales: {...common.scales,
        rpm: { position: 'left', beginAtZero: true, ticks: { color: '#8b93a2' }, grid: { color: '#2e333d' }, title: { display: true, text: 'RPM', color: '#8b93a2' } },
        pwm: { position: 'right', min: 0, max: 100, ticks: { color: '#8b93a2' }, grid: { drawOnChartArea: false }, title: { display: true, text: 'PWM %', color: '#8b93a2' } }
      }}}));
    } catch (e) {
      historyCharts.forEach(chart => chart.destroy());
      historyCharts = [];
      const modal = historyModal();
      const empty = $(modal, '.fcp2-history-empty');
      $(modal, '.fcp2-history-charts').hidden = true;
      if (request === historyRequest && !modal.hidden) {
        empty.textContent = 'History could not be loaded.';
        empty.hidden = false;
      }
    }
  }
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !historyModal().hidden) closeHistory(); });

  // ------- toast -------
  let toastTimer;
  function toast(msg, isErr) {
    const t = document.getElementById('fcp2-toast');
    t.textContent = msg;
    t.classList.toggle('error', !!isErr);
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 3200);
  }

  // ------- range slider fill + number sync -------
  function fillRange(r) {
    const min = Number(r.min) || 0, max = Number(r.max) || 100, value = Number(r.value);
    const fill = max > min ? Math.max(0, Math.min(100, (value - min) * 100 / (max - min))) : 0;
    r.style.setProperty('--fill', `${fill}%`);
  }
  // range ↔ number input pairs inside a card (synced via delegated input events)
  const RANGE_PAIRS = [
    ['f-min-r', 'f-min'], ['f-max-r', 'f-max'],
    ['f-idle-r', 'f-idle'], ['f-cap-r', 'f-cap'],
  ];
  function syncRangePair(card, target) {
    for (const [rangeCls, numCls] of RANGE_PAIRS) {
      if (target.classList.contains(rangeCls)) {
        $(card, '.' + numCls).value = target.value;
        fillRange(target); drawCurve(card);
        return;
      }
      if (target.classList.contains(numCls)) {
        const r = $(card, '.' + rangeCls);
        r.value = Math.max(0, Math.min(100, parseInt(target.value, 10) || 0));
        fillRange(r); drawCurve(card);
        return;
      }
    }
  }

  // ------- payload / dirty tracking -------
  function payload(card) {
    const fd = new FormData();
    fd.append('file', card.dataset.file);
    fd.append('custom', $(card, '.f-custom').value.trim());
    fd.append('controller', $(card, '.f-controller').value);
    fd.append('service', $(card, '.f-service').checked ? '1' : '0');
    fd.append('min_pct', $(card, '.f-min').value);
    fd.append('max_pct', $(card, '.f-max').value);
    fd.append('idle_pct', $(card, '.f-idle').value);
    fd.append('quiet', $(card, '.f-quiet').checked ? '1' : '0');
    fd.append('quiet_cap_pct', $(card, '.f-cap').value);
    fd.append('interval', $(card, '.f-interval').value);
    fd.append('syslog', $(card, '.f-syslog').checked ? '1' : '0');
    for (const src of $$(card, '.fcp2-src')) {
      fd.append('src_type[]', src.dataset.type);
      fd.append('src_low[]', $(src, '.f-src-low').value);
      fd.append('src_high[]', $(src, '.f-src-high').value);
      if (src.dataset.type === 'disks') {
        const ids = $$(src, '.f-src-disk:checked').map(c => c.value);
        fd.append('src_disks[]', ids.join(','));
        fd.append('src_path[]', '');
      } else {
        fd.append('src_disks[]', '');
        fd.append('src_path[]', $(src, '.f-src-path').value);
      }
    }
    return fd;
  }
  const serialize = card => new URLSearchParams(payload(card)).toString();

  function setDirty(card) {
    const dirty = serialize(card) !== card.dataset.snapshot;
    card.classList.toggle('is-dirty', dirty);
    document.getElementById('fcp2-applyall').disabled =
      !$$(document, '.fcp2-card.is-dirty').length;
  }
  function snapshot(card) {
    card.dataset.snapshot = serialize(card);
    card.dataset.savedName = $(card, '.f-custom').value.trim();
    setDirty(card);
  }

  function validate(card) {
    const min = +$(card, '.f-min').value, max = +$(card, '.f-max').value,
          idle = +$(card, '.f-idle').value, cap = +$(card, '.f-cap').value,
          quiet = $(card, '.f-quiet').checked;
    if (!/^[A-Za-z0-9_]+$/.test($(card, '.f-custom').value.trim()))
      return 'Name: letters, numbers, underscores only.';
    if (!$(card, '.f-controller').value) return 'Select a PWM output.';
    if (min > max) return 'Min speed exceeds max.';
    if (idle > min) return 'Idle speed exceeds min.';
    if (quiet && (cap < min || cap > max)) return 'Quiet ceiling must sit between min and max.';
    for (const src of $$(card, '.fcp2-src')) {
      const lo = +$(src, '.f-src-low').value, hi = +$(src, '.f-src-high').value;
      if (!(lo < hi)) return `Source range ${lo}–${hi}°C: low must be below high.`;
      if (src.dataset.type === 'disks' && !$$(src, '.f-src-disk:checked').length)
        return 'A disk source has no disks selected.';
    }
    return null;
  }

  // ------- response curve -------
  const SRC_COLORS = { disks: '#6ab0ff', temp: '#ff8c2f' };
  const EXTRA = ['#34d17b', '#ffb03a', '#c792ea', '#ff5252'];
  function drawCurve(card) {
    const svg = $(card, '.f-curve');
    if (!svg) return;
    const W = 420, H = 130, L = 34, R = 10, T = 8, B = 20;
    const x0 = 20, x1 = 100;
    const X = t => L + (t - x0) / (x1 - x0) * (W - L - R);
    const Y = p => T + (100 - p) / 100 * (H - T - B);
    const min = +$(card, '.f-min').value, max = +$(card, '.f-max').value;
    const quiet = $(card, '.f-quiet').checked, cap = +$(card, '.f-cap').value;
    let g = '<g class="grid">';
    for (const p of [0, 50, 100]) g += `<line x1="${L}" y1="${Y(p)}" x2="${W - R}" y2="${Y(p)}"/>`;
    g += '</g><g class="axis">';
    for (const p of [0, 50, 100]) g += `<text x="${L - 6}" y="${Y(p) + 3}" text-anchor="end">${p}%</text>`;
    for (const t of [20, 40, 60, 80, 100]) g += `<text x="${X(t)}" y="${H - 6}" text-anchor="middle">${t}°</text>`;
    g += '</g>';
    const srcs = $$(card, '.fcp2-src');
    const legend = [];
    let tempSeen = 0;
    srcs.forEach((src, i) => {
      const lo = +$(src, '.f-src-low').value, hi = +$(src, '.f-src-high').value;
      if (!(lo < hi)) return;
      let color = SRC_COLORS[src.dataset.type];
      if (src.dataset.type === 'temp' && tempSeen++ > 0)
        color = EXTRA[(tempSeen - 2) % EXTRA.length];
      const pts = [
        [x0, min], [Math.max(x0, lo), min],
        [Math.min(x1, hi), max], [x1, max],
      ].map(([t, p]) => `${X(t).toFixed(1)},${Y(p).toFixed(1)}`).join(' ');
      g += `<polyline points="${pts}" fill="none" stroke="${color}" stroke-width="2"/>`;
      legend.push(`<span style="color:${color}">■</span> ${src.dataset.type === 'disks' ? 'disks' : 'sensor'} ${lo}–${hi}°`);
    });
    if (quiet) {
      g += `<line class="ceiling" x1="${L}" y1="${Y(cap)}" x2="${W - R}" y2="${Y(cap)}"/>` +
           `<text x="${W - R}" y="${Y(cap) - 4}" text-anchor="end" fill="var(--warn)" font-size="10">ceiling ${cap}%</text>`;
    }
    svg.innerHTML = g;
    const lg = $(card, '.f-curve-legend');
    if (lg) lg.innerHTML = legend.join(' &nbsp; ');
  }

  // ------- disk picker summary -------
  function updateDiskSummary(src) {
    const n = $$(src, '.f-src-disk:checked').length;
    $(src, '.f-disk-summary').textContent = `${n} disk${n === 1 ? '' : 's'} selected`;
  }

  // ------- card wiring -------
  // No listeners are attached to the card: every interaction is handled by
  // the delegated document-level handlers below, so cards keep working even
  // if Unraid replaces the mounted DOM nodes.
  function initCard(card) {
    for (const r of $$(card, 'input[type="range"]')) fillRange(r);
    drawCurve(card);
    snapshot(card);
  }

  function addSource(card, tplId) {
    const tpl = document.getElementById(tplId);
    const node = tpl.content.firstElementChild.cloneNode(true);
    $(card, '.f-sources').appendChild(node);
    drawCurve(card); setDirty(card);
  }

  // close open disk menus when clicking elsewhere
  document.addEventListener('click', e => {
    for (const d of $$(document, '.fcp2-disksel[open]')) {
      if (!d.contains(e.target)) d.removeAttribute('open');
    }
  });

  // ------- server ops -------
  async function save(card) {
    const err = validate(card);
    const errEl = $(card, '.f-err');
    if (err) { errEl.textContent = err; return false; }
    errEl.textContent = '';
    try {
      const res = await fetch(SAVE, { method: 'POST', body: payload(card) });
      const j = await res.json();
      if (j.status !== 'ok') { errEl.textContent = j.message || 'Save failed'; return false; }
      card.dataset.file = j.file;
      snapshot(card);
      toast(`Saved ${$(card, '.f-custom').value.trim()}`);
      return true;
    } catch (e) {
      errEl.textContent = 'Save failed: ' + e;
      return false;
    }
  }

  async function del(card) {
    const name = $(card, '.f-custom').value.trim() || card.dataset.file;
    if (!card.dataset.file) {
      card.remove();
      toast('Discarded new fan');
      return;
    }
    if (!confirm(`Delete fan "${name}"? This removes its configuration.`)) return;
    const fd = new FormData();
    fd.append('op', 'delete');
    fd.append('file', card.dataset.file);
    try {
      const j = await (await fetch(API, { method: 'POST', body: fd })).json();
      if (j.status !== 'ok') { toast(j.message || 'Delete failed', true); return; }
      card.remove();
      toast(`Deleted ${name}`);
    } catch (e) {
      toast('Delete failed: ' + e, true);
    }
  }

  function runNow(card) {
    const name = card.dataset.savedName;
    if (!name) { toast('Save the fan first', true); return; }
    fetch(`${API}?op=refresh_single&custom=${encodeURIComponent(name)}`)
      .then(() => toast(`Applied current temperatures to ${name}`));
  }

  function addFan() {
    const currentGrid = document.getElementById('fcp2-grid');
    const addButton = document.getElementById('fcp2-addfan');
    const card = document.getElementById('fcp2-tpl-fan').content.firstElementChild.cloneNode(true);
    currentGrid.insertBefore(card, addButton);
    initCard(card);
    $(card, '.f-custom').focus();
  }

  async function applyAll() {
    for (const card of $$(document, '.fcp2-card.is-dirty')) {
      if (!await save(card)) break;
    }
  }

  // ------- outputs panel -------
  async function saveLabel(row) {
    const fd = new FormData();
    fd.append('op', 'savelabel');
    fd.append('pwm', row.dataset.pwm);
    fd.append('label', $(row, '.label-in').value.trim());
    const j = await (await fetch(API, { method: 'POST', body: fd })).json();
    toast(j.message || 'Label saved', j.status !== 'ok');
  }

  function manualLabel(path) {
    const option = Array.from(manualElements().controller.options).find(o => o.value === path);
    return option ? option.textContent : path;
  }
  function renderManual(state) {
    const manual = manualElements();
    manualActive = !!state.active;
    manual.warning.hidden = !manualActive;
    manual.start.textContent = manualActive ? 'Update speed' : 'Start test';
    for (const button of $$(document, '.fcp2-manual-stop')) button.disabled = !manualActive;
    if (!manualActive) return;
    manual.details.open = true;
    if (!state.controller || state.percent == null || state.expires_at == null) {
      document.getElementById('fcp2-manual-warning-text').textContent =
        'Manual PWM state requires restoration; use Stop test or check the system log';
      return;
    }
    manual.controller.value = state.controller;
    manual.range.value = manual.percent.value = state.percent;
    fillRange(manual.range);
    const remaining = Math.max(0, state.expires_at - Math.floor(Date.now() / 1000));
    document.getElementById('fcp2-manual-warning-text').textContent =
      `${manualLabel(state.controller)} at ${state.percent}% · auto-stops in ${Math.ceil(remaining / 60)} min`;
  }
  let manualGeneration = 0;
  let manualMutationPending = false;
  async function manualRequest(op, body, {silent = false} = {}) {
    const mutation = op !== 'manual_status';
    if (mutation && manualMutationPending) return null;
    if (!mutation && manualMutationPending) return null;
    if (mutation) manualMutationPending = true;
    const generation = mutation ? ++manualGeneration : manualGeneration;
    try {
      const response = await fetch(`${API}?op=${op}`, body ? {method: 'POST', body} : undefined);
      const state = await response.json();
      if (generation === manualGeneration && Object.prototype.hasOwnProperty.call(state, 'active')) renderManual(state);
      if (state.status !== 'ok') {
        if (!silent) toast(state.message || 'Manual test request failed', true);
        return null;
      }
      return state;
    } catch (e) {
      if (!silent) toast(e.message || String(e), true);
      return null;
    } finally {
      if (mutation) manualMutationPending = false;
    }
  }
  function syncManualRange() {
    const manual = manualElements();
    manual.percent.value = manual.range.value;
    fillRange(manual.range);
  }
  function syncManualPercent() {
    const manual = manualElements();
    const value = Math.max(10, Math.min(100, parseInt(manual.percent.value, 10) || 10));
    manual.range.value = value; fillRange(manual.range);
  }
  async function startManualTest() {
    const manual = manualElements();
    const wasActive = manualActive;
    const percent = Number(manual.percent.value);
    if (!Number.isInteger(percent) || percent < 10 || percent > 100) { toast('Speed must be from 10 to 100%', true); return; }
    const fd = new FormData(); fd.append('controller', manual.controller.value); fd.append('percent', String(percent));
    const state = await manualRequest('manual_start', fd);
    if (state) toast(wasActive ? 'Manual test speed updated' : 'Manual test started');
  }
  async function stopManualTest() {
    const fd = new FormData();
    const state = await manualRequest('manual_stop', fd);
    if (state) toast('Manual test stopped');
  }
  // Unraid's newer web UI can replace mounted page controls. Delegating every
  // interaction from document keeps all controls live when nodes are replaced.
  document.addEventListener('click', e => {
    if (!(e.target instanceof Element)) return;
    // page-level controls
    if (e.target.closest('#fcp2-addfan')) return addFan();
    if (e.target.closest('#fcp2-manual-start')) return startManualTest();
    if (e.target.closest('.fcp2-manual-stop')) return stopManualTest();
    if (e.target.closest('#fcp2-applyall')) return applyAll();
    if (e.target.closest('.fcp2-history-close')) return closeHistory();
    if (e.target === historyModal()) return closeHistory();
    const labelRow = e.target.closest('.fcp2-outrow2');
    if (labelRow && e.target.closest('.o-savelabel')) return saveLabel(labelRow);
    // per-card controls
    const card = e.target.closest('.fcp2-card');
    if (!card) return;
    if (e.target.closest('.f-apply')) save(card);
    else if (e.target.closest('.f-revert')) location.reload();
    else if (e.target.closest('.f-delete')) del(card);
    else if (e.target.closest('.f-runnow')) runNow(card);
    else if (e.target.closest('.f-history')) openHistory(card);
    else if (e.target.closest('.f-add-disks')) addSource(card, 'fcp2-tpl-disks');
    else if (e.target.closest('.f-add-temp')) addSource(card, 'fcp2-tpl-temp');
    else if (e.target.closest('.rm')) {
      e.target.closest('.fcp2-src').remove();
      drawCurve(card); setDirty(card);
    }
  }, true);
  document.addEventListener('input', e => {
    if (!(e.target instanceof Element)) return;
    if (e.target.matches('#fcp2-manual-range')) return syncManualRange();
    if (e.target.matches('#fcp2-manual-percent')) return syncManualPercent();
    const card = e.target.closest('.fcp2-card');
    if (!card) return;
    syncRangePair(card, e.target);
    setDirty(card);
  }, true);
  document.addEventListener('change', e => {
    if (!(e.target instanceof Element)) return;
    if (e.target.matches('#fcp2-airflow')) return airflowToggle(e.target.checked);
    const card = e.target.closest('.fcp2-card');
    if (!card) return;
    if (e.target.classList.contains('f-service'))
      card.classList.toggle('is-disabled', !e.target.checked);
    if (e.target.classList.contains('f-quiet')) {
      $(card, '.f-quietbody').hidden = !e.target.checked;
      drawCurve(card);
    }
    const src = e.target.closest('.fcp2-src');
    if (src && e.target.classList.contains('f-src-disk')) updateDiskSummary(src);
    if (src) drawCurve(card);
    setDirty(card);
  }, true);
  document.addEventListener('toggle', e => {
    if (e.target.matches?.('#fcp2-manual') && manualActive && !e.target.open) e.target.open = true;
  }, true);
  fillRange(manualElements().range);

  async function airflowToggle(enabled) {
    const fd = new FormData();
    fd.append('op', 'fcp_airflow_toggle');
    fd.append('enabled', enabled ? '1' : '0');
    await fetch(API, { method: 'POST', body: fd });
    toast(`Dashboard airflow tile ${enabled ? 'enabled' : 'disabled'}`);
  }

  // ------- live status -------
  async function poll() {
    await manualRequest('manual_status', null, {silent: true});
    try {
      const st = await (await fetch(`${API}?op=status`)).json();
      const pill = document.getElementById('fcp2-status');
      const running = st.status === 'running';
      const noFans = !running && st.enabled === 0;
      pill.classList.toggle('is-running', running);
      pill.classList.toggle('is-stopped', !running && !noFans);
      $(pill, '.txt').textContent = running ? 'Running' : (noFans ? 'No fans enabled' : 'Stopped');
    } catch (e) { /* ignore */ }
    for (const card of $$(document, '.fcp2-card')) {
      const name = card.dataset.savedName;
      if (!name) continue;
      try {
        const txt = await (await fetch(
          `${API}?op=read_temp_rpm&custom=${encodeURIComponent(name)}`)).text();
        const [temp, rpm] = txt.split('|');
        $(card, '.f-live-rpm').textContent = (rpm && rpm !== '?') ? rpm : '–';
        $(card, '.f-live-now').textContent =
          (temp && temp !== '*') ? temp.replace('(', '· ').replace(')', '') + '°C' : 'no data';
      } catch (e) { /* ignore */ }
    }
  }
  poll();
  setInterval(poll, 5000);

  // ------- boot -------
  for (const card of $$(document, '.fcp2-card')) initCard(card);

  window.addEventListener('beforeunload', e => {
    if ($$(document, '.fcp2-card.is-dirty').length) e.preventDefault();
  });
})();
</script>
